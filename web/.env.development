# Used by `npm run dev`. Safe to commit: contains only local, non-secret URLs.
# Override per machine in .env.development.local (git-ignored).

# Where the frontend sends API requests (must match the API's launchSettings applicationUrl).
VITE_API_URL=http://localhost:5080

# Vite dev server port (must be listed in the API's Cors:AllowedOrigins).
DEV_SERVER_PORT=5173
